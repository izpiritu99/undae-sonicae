# Files are stored exactly as they are on Linux. Git for Windows (core.autocrlf true) checks other text files out
# with CRLF, which is fine for MSVC; these must keep fixed line endings:
*.sh            text eol=lf
gradlew         text eol=lf
*.bat           text eol=crlf
# byte-exact: the JUCE patch matches JUCE's CRLF files, and Projucer writes its output with CRLF
*.patch         -text
cpp/JuceLibraryCode/**  -text
